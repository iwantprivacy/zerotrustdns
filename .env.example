# Required — fill these with credentials for your own Cloudflare account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional
CLOUDFLARE_LIST_ITEM_LIMIT=300000   # project policy (300 lists × 1,000 entries)
# Lower this to match your account's actual quota and unrelated list usage.
CLOUDFLARE_LIST_ACCOUNT_LIMIT=300
# Abort a suspicious large shrink below this retained-domain ratio (0..1).
CLOUDFLARE_MIN_DOMAIN_RETENTION_RATIO=0.5
# Set to 1 only when you intentionally approve a large shrink.
CLOUDFLARE_ALLOW_LARGE_SHRINK=0

# Custom filter lists (one URL per line, leave blank to use defaults)
# BLOCKLIST_URLS=
# ALLOWLIST_URLS=
